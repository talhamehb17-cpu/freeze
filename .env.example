# ---------------------------------------------------------------------------
# Tahseen Jaber Cold Storage & Logistics — environment template
# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.
#
#   cp .env.example .env.local
#
# SECURITY RULES
#   * NEVER commit real credentials.
#   * NEVER expose DATABASE_URL (or any *_SECRET) to the browser.
#       - Only vars WITHOUT the `NEXT_PUBLIC_` prefix reach the server.
#       - All database access happens in server components / server actions /
#         route handlers. No client component ever imports `src/lib/db`.
#   * If a credential was ever pasted into a spec, chat, or commit, ROTATE IT
#     before deploying. Treat it as compromised.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# When set, the app uses the Drizzle/pg driver against a real PostgreSQL DB.
# When absent, the app falls back to the local file datastore (.data/*.json)
# so the whole product remains fully functional for demos and CI.
DATABASE_URL=

# --- Auth ------------------------------------------------------------------
# 32+ byte random string. Generate: `openssl rand -base64 48`
AUTH_SECRET=

# Session cookie lifetime in seconds (default 86400 = 24h)
AUTH_SESSION_TTL=

# Optional Google OAuth — enabled automatically once both values are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Notifications (optional) ---------------------------------------------
# SMTP connection string used for admin inquiry alerts.
EMAIL_SERVER=
EMAIL_FROM=

# WhatsApp Business Cloud API — used only for opt-in operational alerts.
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- Public site config (safe for the browser) -----------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# --- Rate limiting / spam protection ---------------------------------------
# Max public form submissions per IP per window.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_SECONDS=

# --- Bootstrap admin (used by `npm run db:seed` only) ----------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Telemetry provider (spec: real vs simulated data) ---------------------
# BOTH must be set to switch the telemetry layer from DEMO to LIVE.
#
# While either is empty the app uses the synthetic provider, every reading is
# flagged `simulated: true`, and the UI renders a DEMO badge. Nothing synthetic
# is ever labelled live, real-time, current or operational.
#
# The endpoint must return an array of:
#   { at: ISO-8601, zone: string, temperature: number, humidity: number }
# It is called as `GET {URL}/telemetry?zone={zoneId}&points={n}` with an
# `Authorization: Bearer {TOKEN}` header.
TELEMETRY_PROVIDER_URL=
TELEMETRY_PROVIDER_TOKEN=
